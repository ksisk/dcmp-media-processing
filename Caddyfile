# DCMP Media portal — one address for the keying pipeline, Media Forager and the host monitor.
# Upstreams are set in .env (KEYING_UPSTREAM, FORAGER_UPSTREAM); the apps keep their own addresses too.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	# Keying pipeline (CT 500). handle_path strips the prefix; the app also tolerates it (BASE_PATH=/keying).
	handle_path /keying/* {
		reverse_proxy {$KEYING_UPSTREAM} {
			flush_interval -1            # /events is server-sent events: stream, don't buffer
			header_up X-Forwarded-Prefix /keying
		}
	}
	redir /keying /keying/ 301

	# Media Forager (CT 400). Its own basic auth, if enabled, passes straight through.
	handle_path /forager/* {
		reverse_proxy {$FORAGER_UPSTREAM} {
			header_up X-Forwarded-Prefix /forager
		}
	}
	redir /forager /forager/ 301

	# The portal itself: static shell + vendored font
	handle {
		root * /srv
		file_server
		header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	}
}
